{
  "id": "kit-inventory-covering-todos",
  "title": "Finished-kit leftovers stay on the inventory spec — no empty map rows, no TODO file",
  "role": "doc-graduate",
  "user": "Fully support everything the vendor API offers. Keep leftover methods on KitApi — do not give them their own spec or TODO files.",
  "fixture": "fixtures/kit-inventory",
  "expect": {
    "files_must_not_exist": [
      "docs/features/Files.md",
      "docs/features/Files-TODO.md",
      "docs/features/Embeddings.md",
      "docs/features/Embeddings-TODO.md"
    ]
  },
  "pack_contract": {
    "source_must_include": [
      {
        "file": "docs/templates/agent/workflow/naming-layout.md",
        "patterns": [
          "Inventory / catch-all vs new map rows",
          "Do not add map rows for vague planned-only items",
          "Terse ≠ vague",
          "Do **not** create a `*-TODO.md`"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/understanding.md",
        "patterns": [
          "this stem’s spec",
          "Do **not** create a `*-TODO.md`"
        ]
      }
    ],
    "summaries_must_point": [
      {
        "file": "docs/templates/agent/roles/doc-graduate.md",
        "must_contain": ["Do **not** create a `*-TODO.md`"],
        "must_not_contain": ["Pickup ≠ backlog"]
      },
      {
        "file": "docs/templates/agent/roles/template-sync.md",
        "must_contain": ["Do not create or edit `*-TODO.md`"],
        "must_not_contain": ["Pickup ≠ backlog"]
      }
    ]
  }
}
