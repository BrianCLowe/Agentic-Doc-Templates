{
  "id": "kit-inventory-covering-todos",
  "title": "Finished-kit spec leftovers stay on the inventory stem as TODOs — no empty map rows, no wait-for-pickup",
  "role": "doc-graduate",
  "user": "Fully support everything the vendor API offers. Keep leftover methods on KitApi — do not give them their own spec or TODO files.",
  "fixture": "fixtures/kit-inventory",
  "expect": {
    "files_must_change": [
      "docs/features/KitApi-TODO.md"
    ],
    "files_must_not_exist": [
      "docs/features/Files.md",
      "docs/features/Files-TODO.md",
      "docs/features/Embeddings.md",
      "docs/features/Embeddings-TODO.md"
    ],
    "file_must_contain": [
      {
        "path": "docs/features/KitApi-TODO.md",
        "patterns": ["Files", "embed"]
      }
    ]
  },
  "pack_contract": {
    "source_must_include": [
      {
        "file": "docs/templates/agent/workflow/naming-layout.md",
        "patterns": [
          "Inventory / catch-all vs new map rows",
          "Do not add map rows for vague planned-only items",
          "Terse ≠ vague"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/todos.md",
        "patterns": [
          "Finished-kit contract ⇒ covering TODOs",
          "Pickup ≠ backlog",
          "is **not** inventing work",
          "Terse + public contract"
        ]
      },
      {
        "file": "docs/templates/CHANGELOG.md",
        "patterns": [
          "optional-todo-kit-coverage"
        ]
      },
      {
        "file": "docs/templates/agent/TEMPLATE_SYNC_B.md",
        "patterns": [
          "optional-todo-kit-coverage",
          "no vendor-doc fetch",
          "add **one** Medium item"
        ]
      },
      {
        "file": "docs/templates/agent/roles/todo-warden.md",
        "patterns": [
          "Kit coverage hole (Workflow §5.4)",
          "at most one** §5.4 research item"
        ]
      }
    ],
    "summaries_must_point": [
      {
        "file": "docs/templates/agent/roles/orchestrator.md",
        "must_contain": ["§5.4"],
        "must_not_contain": ["Pickup ≠ backlog"]
      },
      {
        "file": "docs/templates/agent/roles/doc-graduate.md",
        "must_contain": ["§5.4"],
        "must_not_contain": ["Pickup ≠ backlog"]
      },
      {
        "file": "docs/templates/agent/roles/template-sync.md",
        "must_contain": ["kit-coverage"],
        "must_not_contain": ["Pickup ≠ backlog"]
      }
    ]
  }
}
