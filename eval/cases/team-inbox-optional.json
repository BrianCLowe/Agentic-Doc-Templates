{
  "id": "team-inbox-optional",
  "title": "team_inbox is optional — unset stays human-only; roster is two-stage (read vs self-ID), not a forced bot org chart",
  "role": "feature-implementer",
  "user": "What’s left on the human TODO?",
  "fixture": "fixtures/ship-first-crud",
  "expect": {
    "files_must_not_change": [
      "docs/ADT-settings.yaml"
    ],
    "files_must_not_exist": [
      "docs/Team-Roster.md"
    ]
  },
  "pack_contract": {
    "source_must_include": [
      {
        "file": "docs/templates/agent/ADT-settings.example.yaml",
        "patterns": [
          "team_inbox",
          "omit this entire key = human-only inbox",
          "Do not force a project into",
          "Stamp-on-dual-write",
          "apply defaults to Open",
          "Claim / reassign is override only",
          "Never paste secrets or bot credentials",
          "Team-Roster.md",
          "coding agents on a handoff READ",
          "named humans"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/human-todo.md",
        "patterns": [
          "team_inbox",
          "Claim / reassign is override only",
          "do not force",
          "human-only inbox (legacy)",
          "stamp Assignee from `kind_defaults`",
          "apply defaults to Open",
          "one digest ping",
          "no silent agent close",
          "assign playtest to QA",
          "two-stage",
          "self-ID",
          "report-only",
          "Do not invent",
          "Anti-jobs",
          "One initial PR",
          "competing",
          "Human self-ID",
          "fallback-stamp `human`",
          "Put me on the roster as Alex"
        ]
      },
      {
        "file": "docs/templates/Team_Roster_Template.md",
        "patterns": [
          "Team roster",
          "when this project enabled `team_inbox`",
          "Empty Active is correct",
          "Bots **write their own row**",
          "not a live bot",
          "Anti-jobs",
          "Stale row",
          "One initial PR",
          "your** slug",
          "leftover `human`"
        ]
      },
      {
        "file": "docs/templates/Human_TODO_Template.md",
        "patterns": [
          "Assignee:",
          "claim",
          "reassign",
          "Apply defaults to Open",
          "not forced into a bot team",
          "Assign playtest to QA",
          "must **not** invent roster bots",
          "Active on [`Team-Roster.md`]",
          "Put me on the roster as Alex",
          "do not fallback-stamp `human`"
        ]
      },
      {
        "file": "docs/templates/CHANGELOG.md",
        "patterns": [
          "2.8.0",
          "2.8.1",
          "2.9.1",
          "team_inbox",
          "claim / reassign",
          "assign-all-at-once",
          "no silent force",
          "no auto-stamp",
          "two-stage roster",
          "self-ID",
          "named humans",
          "fallback-stamp `human`"
        ]
      }
    ],
    "summaries_must_point": [
      {
        "file": "docs/templates/agent/Modular_Docs_Workflow.md",
        "must_contain": [
          "team_inbox",
          "human-only",
          "self-ID"
        ],
        "must_not_contain": [
          "enabled: true"
        ]
      },
      {
        "file": "docs/templates/agent/roles/todo-warden.md",
        "must_contain": [
          "team_inbox.enabled",
          "confirm report",
          "Invent `Team-Roster.md` bot or human-name rows"
        ],
        "must_not_contain": [
          "Mark human-only items done; invent Human-TODO spam"
        ]
      },
      {
        "file": "docs/templates/agent/TEMPLATE_SYNC_B.md",
        "must_contain": [
          "Do **not** copy a `team_inbox:` key",
          "do not silent-enable",
          "Create `Team-Roster.md` from the template **only**"
        ],
        "must_not_contain": [
          "team_inbox.enabled: true"
        ]
      },
      {
        "file": "DECISIONS.md",
        "must_contain": [
          "D19",
          "D20",
          "non-forcing",
          "human-only inbox",
          "assign-all-at-once",
          "Do not silent-enable",
          "two-stage",
          "self-ID",
          "Anti-jobs",
          "One initial PR",
          "D22",
          "Named humans"
        ]
      },
      {
        "file": "docs/templates/agent/BOOTSTRAP.md",
        "must_contain": [
          "continue to Step 3v",
          "named-human fill-in"
        ]
      }
    ]
  }
}
