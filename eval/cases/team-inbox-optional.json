{
  "id": "team-inbox-optional",
  "title": "Human-TODO is the one human inbox: what's left summarizes Open only, close needs the human's confirm, no roster file",
  "role": "feature-implementer",
  "user": "What’s left on the human TODO?",
  "fixture": "fixtures/build-first-crud",
  "expect": {
    "files_must_not_change": [
      "docs/ADT-settings.yaml"
    ],
    "files_must_not_exist": [
      "docs/Team-Roster.md"
    ]
  },
  "pack_contract": {
    "source_must_include": [
      {
        "file": "docs/templates/Human_TODO_Template.md",
        "patterns": [
          "## Open",
          "## Done",
          "`procure` - `decide` - `waiting`",
          "Move finished items here",
          "Done-only-on-confirm"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/human-todo.md",
        "patterns": [
          "**One project inbox for humans**",
          "**The inbox is the only list.**",
          "summarize **Open** from `Human-TODO.md` only",
          "Only the human's confirm counts",
          "**No silent agent close.**"
        ]
      },
      {
        "file": "docs/templates/CHANGELOG.md",
        "patterns": [
          "2.8.0",
          "2.8.1",
          "2.9.1",
          "2.9.2",
          "2.14.0",
          "team_inbox",
          "claim / reassign",
          "assign-all-at-once",
          "no silent force",
          "no auto-stamp",
          "two-stage roster",
          "self-ID",
          "named humans",
          "fallback-stamp `human`",
          "only if that `role_id` is Active"
        ]
      }
    ],
    "summaries_must_point": [
      {
        "file": "docs/templates/agent/Modular_Docs_Workflow.md",
        "must_contain": [
          "`Human-TODO.md`** = *what only a human can close*",
          "workflow/human-todo.md"
        ],
        "must_not_contain": [
          "team_inbox",
          "Team-Roster",
          "enabled: true"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/human-todo.md",
        "must_contain": [
          "confirm report",
          "Do not create `*-TODO.md`."
        ],
        "must_not_contain": [
          "team_inbox",
          "Assignee",
          "Mark human-only items done; invent Human-TODO spam"
        ]
      },
      {
        "file": "docs/templates/agent/TEMPLATE_SYNC_B.md",
        "must_not_contain": ["team_inbox", "Team-Roster.md"]
      },
      {
        "file": "docs/templates/agent/skills/adt-template-sync/TEMPLATE_SYNC_B.md",
        "must_not_contain": ["team_inbox"]
      },
      {
        "file": "docs/templates/agent/ADT-settings.example.yaml",
        "must_not_contain": ["team_inbox"]
      },
      {
        "file": "DECISIONS.md",
        "must_contain": [
          "D19",
          "D20",
          "non-forcing",
          "human-only inbox",
          "assign-all-at-once",
          "Do not silent-enable",
          "two-stage",
          "self-ID",
          "Anti-jobs",
          "One initial PR",
          "D22",
          "Named humans"
        ]
      },
      {
        "file": "docs/templates/agent/skills/adt-bootstrap/SKILL.md",
        "must_contain": ["continue to Step 3v"]
      },
      {
        "file": "docs/templates/agent/BOOTSTRAP.md",
        "must_contain": ["Do not create `*-TODO.md`."],
        "must_not_contain": ["team_inbox", "Team_Roster"]
      }
    ]
  }
}
