{
  "id": "standing-playbook-override-only",
  "title": "standing.instructions is for ADT playbook overrides — not a notes pad",
  "role": "feature-implementer",
  "user": "When prompting XaiBrain / the xAI API, give the task and expected response structure only. Grok 4.6+ is the model — no long role-play or over-explained prompt engineering.",
  "fixture": "fixtures/ship-first-crud",
  "expect": {
    "files_must_not_change": [
      "docs/ADT-settings.yaml"
    ]
  },
  "pack_contract": {
    "source_must_include": [
      {
        "file": "docs/templates/agent/workflow/profile-standing.md",
        "patterns": [
          "override an ADT playbook",
          "not a scratch pad",
          "Do not jot random notes",
          "How to prompt",
          "playbook overrides only",
          "Sync relocate",
          "Move then delete"
        ]
      },
      {
        "file": "docs/templates/agent/Modular_Documentation_Rule.mdc",
        "patterns": [
          "override an ADT playbook",
          "Do not jot random notes"
        ]
      },
      {
        "file": "docs/templates/agent/ADT-settings.example.yaml",
        "patterns": [
          "omit this entire key",
          "Missing / empty is the correct default",
          "Do not invent"
        ]
      },
      {
        "file": "docs/templates/CHANGELOG.md",
        "patterns": [
          "2.7.25",
          "playbook overrides only",
          "Standing relocate",
          "Move then delete",
          "2.7.26",
          "omit** the `standing:` key"
        ]
      }
    ],
    "summaries_must_point": [
      {
        "file": "docs/templates/agent/Modular_Documentation_Rule.mdc",
        "must_contain": [
          "ADT playbook overrides"
        ],
        "must_not_contain": [
          "corrects how you just worked"
        ]
      },
      {
        "file": "docs/templates/agent/Modular_Documentation_Rule.instructions.md",
        "must_contain": [
          "ADT playbook overrides"
        ],
        "must_not_contain": [
          "corrects how you just worked"
        ]
      },
      {
        "file": "docs/templates/agent/workflow/profile-standing.md",
        "must_contain": [
          "override an ADT playbook"
        ],
        "must_not_contain": [
          "corrects how the agent just worked"
        ]
      },
      {
        "file": "docs/templates/help/USING_WITH_AGENTS.md",
        "must_contain": [
          "override an ADT playbook"
        ],
        "must_not_contain": [
          "Freeform durable **agent process** prefs"
        ]
      },
      {
        "file": "docs/templates/CHANGELOG.md",
        "must_contain": [
          "Standing relocate"
        ],
        "must_not_contain": [
          "Do not** delete or rewrite existing consumer `standing.instructions`"
        ]
      },
      {
        "file": "docs/templates/agent/ADT-settings.example.yaml",
        "must_contain": [
          "omit this entire key"
        ],
        "must_not_contain": [
          "Examples only — delete and write your own",
          "Prefer docker compose verify",
          "instructions: |"
        ]
      },
      {
        "file": "docs/templates/agent/BOOTSTRAP.md",
        "must_contain": [
          "do not quiz"
        ],
        "must_not_contain": [
          "Any standing playbook overrides to save"
        ]
      }
    ]
  }
}
